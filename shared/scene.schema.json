{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figma AE Bridge Scene v1",
  "type": "object",
  "required": ["version", "frame", "layers"],
  "properties": {
    "version": { "const": 1 },
    "importMode": { "enum": ["create", "append"] },
    "frame": {
      "type": "object",
      "required": ["id", "name", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "backgroundLayerIncluded": { "type": "boolean" }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["name", "kind", "x", "y", "width", "height", "opacity", "visible"],
        "properties": {
          "kind": { "enum": ["rectangle", "ellipse", "text", "vector", "gradient", "image", "video", "unsupported"] },
          "blendMode": { "type": "string" },
          "blur": { "type": "object" },
          "renderBounds": { "type": "object" },
          "vectorGeometry": { "type": "object" },
          "gradient": { "type": "object" },
          "imagePlacement": { "type": "object" },
          "imageMask": { "type": "object" },
          "stroke": { "type": "object" },
          "paths": { "type": "array" }
        }
      }
    }
  }
}
